# AI Center Docker环境变量配置
# 复制此文件为.env并修改相应的值

# 版本号（来自PROJECT_VERSION文件）
VERSION=aihub_v2_beta_0.1

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8081

# MySQL配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=ai_center

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=1

# Elasticsearch配置
ES_HOST=elasticsearch
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=your_es_password_here
ES_SCHEME=http

# RustFS配置
RUSTFS_HOST=rustfs
RUSTFS_PORT=9000
RUSTFS_USER=rustfsadmin
RUSTFS_PASSWORD=your_rustfs_password_here

# MCP配置
MCP_HOST=0.0.0.0
MCP_PORT=8082
MCP_ENABLED=true
