# AI Center Docker应用环境变量配置
# 此配置用于只启动前后端应用，数据库等服务使用已部署的实例
# 复制此文件为.env并修改相应的值

VERSION=aihub_v2_beta_0.1

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8081

# MySQL配置（使用已部署的MySQL）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=ai_center

# Redis配置（使用已部署的Redis）
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=1

# Elasticsearch配置（使用已部署的ES）
ES_HOST=host.docker.internal
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=your_es_password_here
ES_SCHEME=http

# MinIO/RustFS配置（使用已部署的RustFS）
RUSTFS_HOST=host.docker.internal
RUSTFS_PORT=9000
RUSTFS_USER=rustfsadmin
RUSTFS_PASSWORD=your_minio_password_here

# MCP配置
MCP_HOST=0.0.0.0
MCP_PORT=8082
MCP_ENABLED=true

# 说明：
# 1. host.docker.internal 用于在Docker容器内访问宿主机的服务
# 2. 如果数据库等服务部署在其他服务器，请修改对应的HOST地址
# 3. 确保数据库、Redis、Elasticsearch等服务已正确配置并可访问
